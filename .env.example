# Public (browser) — Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only — Privy (Dashboard → App settings → App secret)
PRIVY_APP_SECRET=

# Public — Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — Supabase service role (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Server only — Daily.co (Dashboard → Developers → API key)
DAILY_API_KEY=

# Daily room privacy: "private" (default; app mints meeting tokens for iframe) or "public" (no token needed)
# DAILY_ROOM_PRIVACY=private

# Optional — Base Sepolia RPC (defaults to https://sepolia.base.org)
# BASE_SEPOLIA_RPC_URL=

# Optional — browser RPC for gas estimation on createFlow/deleteFlow (falls back to public Base Sepolia RPC)
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Optional — Underlying **fUSDC** (18 decimals) on Base Sepolia for minting before wrap to fUSDCx
# NEXT_PUBLIC_FUSDC_ADDRESS=
# NEXT_PUBLIC_FUSDCX_ADDRESS=
# Legacy alias (same as FUSDCx if you already set it):
# NEXT_PUBLIC_USDCX_ADDRESS=
# NEXT_PUBLIC_SUPERFLUID_CFA_V1=
# NEXT_PUBLIC_SUPERFLUID_CFA_FORWARDER=

# Optional — Coinbase Developer Platform (paymaster / server APIs).
# CDP paymaster + bundler URLs are configured in the **Privy dashboard** under
# "Wallet infrastructure → Smart wallets" (one network config per chain). The app
# auto-detects the smart wallet client via `useSuperfluidSend` and routes
# createFlow / deleteFlow as gas-sponsored UserOps when a smart wallet exists for
# the user. Without dashboard config it falls back to the embedded EOA path.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Server only — shared secret for the /api/sessions/reconcile cron endpoint.
# Set on the server and pass `Authorization: Bearer <value>` from your scheduler
# (Railway scheduled job, Vercel Cron, GitHub Actions, etc.) every 5 minutes
# (Railway's minimum). See cron/README.md for the bundled Railway cron service.
# SCHEDULED_TASK_SECRET=
