# Public (browser) — Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only — Privy (Dashboard → App settings → App secret)
PRIVY_APP_SECRET=

# Public — Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — Supabase service role (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Server only — Daily.co (Dashboard → Developers → API key)
DAILY_API_KEY=

# Optional — Base Sepolia RPC (defaults to https://sepolia.base.org)
# BASE_SEPOLIA_RPC_URL=

# Optional — Underlying **fUSDC** (18 decimals) on Base Sepolia for minting before wrap to fUSDCx
# NEXT_PUBLIC_FUSDC_ADDRESS=
# NEXT_PUBLIC_FUSDCX_ADDRESS=
# Legacy alias (same as FUSDCx if you already set it):
# NEXT_PUBLIC_USDCX_ADDRESS=
# NEXT_PUBLIC_SUPERFLUID_CFA_V1=
# NEXT_PUBLIC_SUPERFLUID_CFA_FORWARDER=

# Optional — Coinbase Developer Platform (paymaster / server APIs)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
